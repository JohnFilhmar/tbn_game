{
  "name": "@tbn/backend",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS monolith that runs as the web and worker process types.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "db:generate": "prisma generate",
    "build": "prisma generate && nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:web": "node --env-file-if-exists=../.env dist/web.js",
    "start:worker": "node --env-file-if-exists=../.env dist/worker.js",
    "test": "prisma migrate deploy && nest build && NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest",
    "start:admin": "node --env-file-if-exists=../.env dist/admin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-express": "12.1.0",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prometheus-io/client": "0.16.1",
    "@tbn/contracts": "0.0.0",
    "helmet": "8.3.0",
    "nestjs-pino": "5.2.0",
    "pg": "8.23.0",
    "pg-boss": "12.34.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.6",
    "@nestjs/testing": "12.1.0",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.0"
  }
}
