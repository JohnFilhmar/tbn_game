# Example environment. Placeholders only: never put a real secret in this file.
#
# The backend reads its variables once at bootstrap through backend/src/config/config.schema.ts.
# Copy this file to .env to run the backend on the host against the development stack; the
# start:web and start:worker scripts load .env when it exists.
#
# In production the SOPS-encrypted file deploy/secrets/production.enc.env holds the secrets and
# optional settings below. See docs/server_setup.md.

# Backend
NODE_ENV=development
LOG_LEVEL=info
WEB_PORT=3000
WORKER_PORT=3001
# The development stack's database. Production builds this URL from POSTGRES_PASSWORD.
DATABASE_URL=postgresql://tbn:tbn_development_only@127.0.0.1:5432/tbn
DATABASE_POOL_MAX=10
# Comma-separated origins allowed by CORS. Empty allows none.
CORS_ORIGINS=
HTTP_BODY_LIMIT_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=25000
# Set by the image build. Leave it unset when running on the host.
# GIT_COMMIT_SHA=
# Encrypts provider keys at rest. 32 bytes in base64: `openssl rand -base64 32`. Losing it makes
# every saved key unreadable, so keep it with the other secrets.
SECRETS_ENCRYPTION_KEY=replace_with_openssl_rand_base64_32
# How long a login lasts.
SESSION_TTL_MINUTES=720
# Agent runs the worker drives at the same time. Scaling up means raising this on a bigger server.
WORKER_CONCURRENCY=4
# Where agents read and write files. The compose files mount a volume here for the worker.
WORKSPACE_DIR=/workspace
# One model call may take this long before it is retried.
PROVIDER_TIMEOUT_MS=300000
# Attempts per model call, counting the first.
PROVIDER_MAX_ATTEMPTS=4
# A key whose calls fail this many times in a row, after their retries, pauses every run on it.
PROVIDER_BREAKER_THRESHOLD=3
# How long those runs wait before they try the key again.
PROVIDER_BREAKER_COOLDOWN_SECONDS=60
# A worker renews its lease on a run this often; a dead worker's run is picked up after it lapses.
RUN_LEASE_SECONDS=120
# Days the worker keeps the event log; a client away for longer reloads its state. 0 keeps it all.
EVENT_RETENTION_DAYS=0
# Hours an Idempotency-Key replays its answer; after that the key runs again. 0 keeps them all.
COMMAND_RETENTION_HOURS=0
# The built client, which the web process serves under /app. The image sets /app/client. Unset
# serves no client, as when the client runs on the Vite dev server against this backend.
# CLIENT_DIR=../client/dist

# Sandbox launcher, process type sandbox. It alone holds the docker socket.
SANDBOX_PORT=3002
DOCKER_SOCKET=/var/run/docker.sock
# The image sandbox containers run from. Production deploys the digest CI signed.
SANDBOX_IMAGE=tbn/sandbox:development
# The internal network sandbox containers join; the compose file creates it.
SANDBOX_NETWORK=tbn_development_sandbox
# The workspace volume the launcher mounts into containers by subpath, or an absolute host path.
WORKSPACE_VOLUME=tbn_development_workspace
# The uid sandbox containers run as: the sandbox image's agent user, also the worker's uid.
SANDBOX_UID=65532
# Containers at a time, and the ceilings the owner's sandbox preferences cannot exceed.
SANDBOX_MAX_PARALLEL=2
SANDBOX_MAX_CPUS=2
SANDBOX_MAX_MEMORY_MB=2048
SANDBOX_MAX_SCRATCH_MB=1024
# How much of a job's output the job record keeps.
SANDBOX_OUTPUT_MAX_BYTES=65536

# Egress proxy, process type egress_proxy. It holds no database URL and no key.
EGRESS_PROXY_PORT=3128
EGRESS_PROXY_OPS_PORT=3003
# Where the worker and sandbox containers reach the proxy.
EGRESS_PROXY_URL=http://egress_proxy:3128
# Comma-separated hosts the proxy allows. Empty allows every public host.
EGRESS_ALLOWED_HOSTS=
EGRESS_MAX_RESPONSE_BYTES=10485760
EGRESS_MAX_REQUESTS_PER_MINUTE=120
EGRESS_MAX_CONNECTIONS=256

# Outside world
# The fetch tool reads this much of a page before it is cut.
FETCH_MAX_BYTES=2097152
INTEGRATION_TIMEOUT_MS=15000
# The SearXNG instance seeded as a search provider when the owner is created. Unset skips it.
# SEARXNG_URL=http://searxng:8080

# Production secrets, required by docker-compose.production.yml
# A URL-safe password, for example the output of `openssl rand -hex 32`.
POSTGRES_PASSWORD=replace_with_a_generated_password
# For example the output of `openssl rand -hex 32`.
SEARXNG_SECRET=replace_with_a_generated_secret
# The Grafana admin password, for the dashboards on 127.0.0.1:3005. For example `openssl rand -hex 24`.
GRAFANA_ADMIN_PASSWORD=replace_with_a_generated_password
# See above. Required in production too.
# SECRETS_ENCRYPTION_KEY=

# Optional production settings, shown with their defaults
# The host's docker group id, from `stat -c %g /var/run/docker.sock`. The deploy job sets it.
# DOCKER_GID=999
# SANDBOX_MAX_PARALLEL=2
# SANDBOX_MAX_CPUS=2
# SANDBOX_MAX_MEMORY_MB=2048
# SANDBOX_MAX_SCRATCH_MB=1024
# EGRESS_ALLOWED_HOSTS=
# EGRESS_MAX_RESPONSE_BYTES=10485760
# EGRESS_MAX_REQUESTS_PER_MINUTE=120
# LOG_LEVEL=info
# CORS_ORIGINS=
# DATABASE_POOL_MAX=10
# WEB_HOST_PORT=3000
# WEB_CPUS=1.0
# WEB_MEMORY=512M
# WORKER_CPUS=2.0
# WORKER_MEMORY=1G
# How long Prometheus keeps samples.
# PROMETHEUS_RETENTION=30d
# POSTGRES_CPUS=2.0
# POSTGRES_MEMORY=2G
