# Example environment. Placeholders only: never put a real secret in this file.
#
# The backend reads its variables once at bootstrap through backend/src/config/config.schema.ts.
# Copy this file to .env to run the backend on the host against the development stack; the
# start:web and start:worker scripts load .env when it exists.
#
# In production the SOPS-encrypted file deploy/secrets/production.enc.env holds the secrets and
# optional settings below. See docs/server_setup.md.

# Backend
NODE_ENV=development
LOG_LEVEL=info
WEB_PORT=3000
WORKER_PORT=3001
# The development stack's database. Production builds this URL from POSTGRES_PASSWORD.
DATABASE_URL=postgresql://tbn:tbn_development_only@127.0.0.1:5432/tbn
DATABASE_POOL_MAX=10
# Comma-separated origins allowed by CORS. Empty allows none.
CORS_ORIGINS=
HTTP_BODY_LIMIT_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=25000
# Set by the image build. Leave it unset when running on the host.
# GIT_COMMIT_SHA=

# Production secrets, required by docker-compose.production.yml
# A URL-safe password, for example the output of `openssl rand -hex 32`.
POSTGRES_PASSWORD=replace_with_a_generated_password
# For example the output of `openssl rand -hex 32`.
SEARXNG_SECRET=replace_with_a_generated_secret

# Optional production settings, shown with their defaults
# LOG_LEVEL=info
# CORS_ORIGINS=
# DATABASE_POOL_MAX=10
# WEB_HOST_PORT=3000
# WEB_CPUS=1.0
# WEB_MEMORY=512M
# WORKER_CPUS=2.0
# WORKER_MEMORY=1G
# POSTGRES_CPUS=2.0
# POSTGRES_MEMORY=2G
