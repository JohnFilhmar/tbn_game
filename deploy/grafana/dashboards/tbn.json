{
  "uid": "tbn_overview",
  "title": "tbn overview",
  "tags": ["tbn"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Processes",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Processes up",
      "description": "Whether Prometheus reached each process at its last scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "tbn_prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tbn_prometheus"
          },
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Workspace disk used",
      "description": "Share of the workspace volume in use. A notice goes out past the owner's disk alert preference.",
      "datasource": {
        "type": "prometheus",
        "uid": "tbn_prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tbn_prometheus"
          },
          "expr": "max(tbn_workspace_disk_used_percent)",
          "legendFormat": "used"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Live connections",
      "description": "Browser and shell connections to the realtime gateway.",
      "datasource": {
        "type": "prometheus",
        "uid": "tbn_prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tbn_prometheus"
          },
          "expr": "sum(tbn_realtime_connections)",
          "legendFormat": "connections"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "row",
      "title": "Work",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Queue depth",
      "description": "Jobs by queue and state: ready to run, deferred to later, and running.",
      "datasource": {
        "type": "prometheus",
        "uid": "tbn_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tbn_prometheus"
          },
          "expr": "sum by (queue, state) (tbn_queue_jobs{state=~\"ready|deferred|active\"})",
          "legendFormat": "{{queue}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Run failures",
      "description": "Runs that failed, per hour. A paused run is not a failure.",
      "datasource": {
        "type": "prometheus",
        "uid": "tbn_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tbn_prometheus"
          },
          "expr": "delta(tbn_runs{status=\"failed\"}[1h])",
          "legendFormat": "failed per hour"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Runs by status",
      "description": "Every run the company has had, by where it is now.",
      "datasource": {
        "type": "prometheus",
        "uid": "tbn_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tbn_prometheus"
          },
          "expr": "sum by (status) (tbn_runs)",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Failed jobs",
      "description": "Queue jobs that failed for good, by queue.",
      "datasource": {
        "type": "prometheus",
        "uid": "tbn_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tbn_prometheus"
          },
          "expr": "sum by (queue) (tbn_queue_jobs{state=\"failed\"})",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "row",
      "title": "Spend",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Spend by provider",
      "description": "Money spent at the owner's model prices, since the start.",
      "datasource": {
        "type": "prometheus",
        "uid": "tbn_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tbn_prometheus"
          },
          "expr": "sum by (provider) (tbn_usage_cost)",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Spend in the last 24 hours",
      "description": "Money spent per provider over the last day.",
      "datasource": {
        "type": "prometheus",
        "uid": "tbn_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tbn_prometheus"
          },
          "expr": "sum by (provider) (delta(tbn_usage_cost[24h]))",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Tokens per minute",
      "description": "Tokens sent and received per minute, by provider and kind.",
      "datasource": {
        "type": "prometheus",
        "uid": "tbn_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tbn_prometheus"
          },
          "expr": "sum by (provider, kind) (rate(tbn_usage_tokens[5m])) * 60",
          "legendFormat": "{{provider}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "type": "row",
      "title": "Web and proxy",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Cache hit rate",
      "description": "Share of search and page lookups answered from the cache.",
      "datasource": {
        "type": "prometheus",
        "uid": "tbn_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tbn_prometheus"
          },
          "expr": "sum by (cache) (tbn_cache_events{outcome=\"hit\"}) / sum by (cache) (tbn_cache_events)",
          "legendFormat": "{{cache}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Proxy refusals",
      "description": "Egress proxy answers other than ok, per minute, by outcome: refused destinations, missing run identity, rate limits.",
      "datasource": {
        "type": "prometheus",
        "uid": "tbn_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "tbn_prometheus"
          },
          "expr": "sum by (outcome) (rate(tbn_egress_requests_total{outcome!=\"ok\"}[5m])) * 60",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "links": []
}
